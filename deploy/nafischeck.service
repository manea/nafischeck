[Unit]
Description=NafisCheck UAE MoHRE & Nafis Emiratisation Calculator & Auditor
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nafischeck
EnvironmentFile=/etc/nafischeck/.env
ExecStart=/usr/bin/node --no-warnings /opt/nafischeck/server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
